{
  // Global fallback rate limit. Individual APIs can override this.
  "rateLimit": { "max": 120, "timeWindowMs": 60000 },
  // For Cloudflare Worker favicons, prefer Terraform favicon_path plus
  // PAY_API_PROXY_FAVICON_PATH at build time, not base64 in this config.
  "apis": [
    {
      "id": "fx",
      "upstreamBaseUrl": "https://upstream-fx.example.com",
      "methods": ["GET", "POST"],
      "pricing": { "request": "0.001" },
      "routes": [
        { "path": "/v1/quote", "methods": ["GET"], "pricing": { "request": "0.001" } },
        { "path": "/v1/live/*", "methods": ["GET"], "pricing": { "request": "0.002" } },
        { "path": "/v1/status", "methods": ["GET"], "pricing": { "request": "0" } }
      ],
      "rateLimit": { "max": 60, "timeWindowMs": 60000 },
      "responseSanitizer": { "removeJsonKeys": ["cost", "remain_money"] },
      "requestRewrite": {
        "headers": { "content-type": "application/json" },
        "body": {
          "mode": "mergeJson",
          "json": {
            "key": { "env": "VENDOR_FX_API_KEY" }
          }
        }
      },
      "forwardedHeaders": ["accept", "content-type"],
      "upstreamTimeoutMs": 30000
    },
    {
      "id": "weather",
      "upstreamBaseUrl": "https://upstream-weather.example.com",
      "methods": ["GET"],
      "pricing": { "request": "0.003" },
      "routes": [
        { "path": "/v1/current", "methods": ["GET"], "pricing": { "request": "0.003" } },
        { "path": "/v1/forecast/*", "methods": ["GET"], "pricing": { "request": "0.004" } }
      ],
      "rateLimit": { "max": 30, "timeWindowMs": 60000 },
      "forwardedHeaders": ["accept"],
      "upstreamTimeoutMs": 30000
    }
  ]
}
