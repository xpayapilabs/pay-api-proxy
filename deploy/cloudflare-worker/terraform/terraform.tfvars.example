

#export CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

cloudflare_account_id = "replace-with-cloudflare-account-id"
cloudflare_zone_id    = "replace-with-zone-id"

worker_name            = "pay-api-proxy-worker"
custom_domain_hostname = "api.example.com"
public_base_url        = "https://api.example.com"

worker_observability_enabled = true

# First deploy only:
#   terraform apply -var='deployment_phase=bootstrap'
# Then set/use normal for the real Worker and all later deploys.
deployment_phase = "normal"

mpp_secret_key           = "replace-with-random-secret"
tempo_settlement_address = "0x0000000000000000000000000000000000000000"

extra_secret_text_bindings = {
  VENDOR_FX_API_KEY = "replace-with-vendor-fx-api-key"
}

# For real deployments, copy pay-api-proxy.config.example.jsonc to the ignored
# pay-api-proxy.config.jsonc file, edit it, then point this variable there.
pay_api_proxy_config_path = "pay-api-proxy.config.example.jsonc"

# Optional: embed OpenAPI docs in the Worker. Keys must match apis[].id.
# openapi_document_paths = {
#   fx = "fx.openapi.json"
# }
