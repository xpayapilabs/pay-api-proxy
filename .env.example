# Minimal environment template. Copy this file to `.env` and fill in the values
# for your deployment.
# Edit optional app settings in pay-api-proxy.config.jsonc.
# Docker Compose keeps container/deployment defaults in docker-compose.yml.

# Production mode auto-generates a persistent signing secret when NODE_SIGNING_SECRET is omitted.
NODE_ENV=production

# Required for receiving payments. Use the wallet address where payments should settle.
# example: 0x1234567890abcdef1234567890abcdef12345678
PAYMENT_RECIPIENT_ADDRESS=

# Optional: set one default price for normal HTTP API requests.
# Route-level prices in pay-api-proxy.config.jsonc can still override this.
DEFAULT_REQUEST_PRICE=0.0005
# Optional: JSON array or compact per-route prices. The publish guide can fill
# this from an OpenAPI import. Set ROUTE_ALLOWLIST=true to expose only these
# configured routes instead of the default catch-all proxy route.
# ROUTE_PRICES='[{"path":"/v1/quote","methods":["GET"],"pricing":{"request":"0.0005"}}]'
# Compact form (shorter for install commands): GET:/v1/quote=0.0005,POST:/v1/status=0
ROUTE_PRICES=
ROUTE_ALLOWLIST=false
# Optional: path to an OpenAPI JSON file on the server. When set, /openapi.json
# preserves that document and injects x-payment-info for configured routes.
# Use OPENAPI_DOCUMENT_URL when the proxy server/container can fetch the document
# from an internal or public URL.
OPENAPI_DOCUMENT_URL=
# During install, OPENAPI_SOURCE_PATH can be a host file path or a folder
# containing openapi.json/swagger.json; the installer copies it into data.
OPENAPI_SOURCE_PATH=
OPENAPI_DOCUMENT_PATH=

# Tempo network and stablecoin defaults. The publish page can generate mainnet
# values for production; these defaults target Tempo Moderato testnet/pathUSD.
PAYMENT_PROVIDER=tempo-testnet
TEMPO_CHAIN_ID=42431
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_ACCEPTED_ASSET=0x20c0000000000000000000000000000000000000

# Optional: override the internal receipt-signing secret.
# When omitted in production, the node creates and reuses data/node-signing-secret.
# NODE_SIGNING_SECRET=

# Domain name. Use your domain in production, for example api.example.com.
# Do not include http:// or https://. For local development, use localhost.
DOMAIN_NAME=localhost
# Optional full public URL override. Use this for Cloudflare quick tunnel URLs
# or any deployment where the public URL cannot be derived from DOMAIN_NAME.
# PUBLIC_BASE_URL=

# Local host binding for the app container. Existing reverse proxies can point
# at this address; Caddy/Tunnel profiles still talk to the app over Docker DNS.
APP_BIND=127.0.0.1:8787

# Optional: graceful app shutdown timeout. On restart/stop the app rejects new
# requests, waits for active paid requests to finish, then exits.
GRACEFUL_SHUTDOWN_TIMEOUT_MS=60000
APP_STOP_GRACE_PERIOD=75s
WORKER_STOP_GRACE_PERIOD=30s

# Required when upstreamProvider is "openai" in pay-api-proxy.config.jsonc.
OPENAI_API_KEY=

# Optional: backend URL the proxy forwards paid requests to (overrides
# traditionalApis[].upstreamBaseUrl in pay-api-proxy.config.jsonc).
# example: http://host.docker.internal:8000
UPSTREAM_BASE_URL=

# Optional: upstream authentication injected by the proxy when forwarding
# requests to your existing API. For Bearer auth, set UPSTREAM_AUTH_TYPE=bearer
# and put the token here. You can also configure bearer/headers directly in
# pay-api-proxy.config.jsonc.
UPSTREAM_AUTH_TYPE=
UPSTREAM_BEARER_TOKEN=
UPSTREAM_AUTH_HEADER=
UPSTREAM_AUTH_HEADER_VALUE=

# Optional: use Cloudflare Tunnel instead of exposing ports 80/443 on a VPS.
# quick creates a temporary trycloudflare.com URL for testing.
# named uses a remotely-managed Cloudflare tunnel token for a stable hostname.
CLOUDFLARE_TUNNEL_MODE=quick
# Required when CLOUDFLARE_TUNNEL_MODE=named. In Cloudflare Zero Trust, route
# the public hostname to http://app:8080, then paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: fixed billing unit for session-backed token charging.
# Keep this small if adapting to mppx.session({ amount, unitType }).
SESSION_BILLING_UNIT_AMOUNT=1
SESSION_BILLING_UNIT_TYPE=asset-smallest-unit

# Optional: enable native mppx Tempo sessions for clients that send
# Authorization: Payment session credentials directly to /v1/chat/completions.
MPPX_SESSION_ENABLED=false
# Server wallet private key used by mppx to settle/close Tempo channels.
MPPX_SESSION_PRIVATE_KEY=
# HMAC secret for fixed-charge mppx challenges. Defaults to the internal signing secret when unset.
MPP_SECRET_KEY=
MPPX_SESSION_DECIMALS=6
MPPX_SESSION_WAIT_FOR_CONFIRMATION=true

# Publish this node to the xpayapi directory from the worker by default.
# Set XPAYAPI_PUBLISH_ENABLED=false if you do not want to list it.
# PUBLIC_BASE_URL must be a stable public URL for publishing to succeed.
XPAYAPI_PUBLISH_ENABLED=true
XPAYAPI_DIRECTORY_URL=https://api.xpayapi.com
